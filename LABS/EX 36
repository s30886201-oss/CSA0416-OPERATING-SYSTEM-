#include <stdio.h>
#include <stdlib.h>

#define MAX 50

int main()
{
    int disk[MAX], next[MAX];
    int n, i, start, end, blocks;
    int allocated[MAX] = {0};

    // Initialize disk blocks
    for(i = 0; i < MAX; i++)
        next[i] = -1;

    printf("Enter number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter number of blocks required for file: ");
    scanf("%d", &blocks);

    if(blocks > n || blocks <= 0 || n > MAX)
    {
        printf("Invalid number of blocks!\n");
        return 0;
    }

    // Allocate blocks
    start = -1;
    end = -1;

    printf("Enter block numbers to allocate:\n");

    for(i = 0; i < blocks; i++)
    {
        int b;
        scanf("%d", &b);

        if(b < 0 || b >= n || allocated[b])
        {
            printf("Invalid or already allocated block!\n");
            return 0;
        }

        allocated[b] = 1;

        if(start == -1)
            start = b;
        else
            next[end] = b;

        end = b;
    }

    // Directory information
    printf("\nFile Allocation Successful!\n");
    printf("Starting block: %d\n", start);
    printf("Ending block: %d\n", end);

    // Display linked allocation
    printf("\nFile blocks:\n");

    int current = start;

    while(current != -1)
    {
        printf("%d -> ", current);
        current = next[current];
    }

    printf("NULL\n");

    // Display disk block links
    printf("\nBlock\tNext Block\n");

    for(i = 0; i < n; i++)
    {
        if(allocated[i])
            printf("%d\t%d\n", i, next[i]);
    }

    return 0;
}
