#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int source, destination;
    char buffer[100];
    int n;

    /* Create and write content to source file */
    source = open("source.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (source == -1)
    {
        perror("Error creating source file");
        return 1;
    }

    write(source, "This is the content of the source file.\n", 41);

    close(source);

    /* Open source file for reading */
    source = open("source.txt", O_RDONLY);

    if (source == -1)
    {
        perror("Error opening source file");
        return 1;
    }

    /* Create destination file */
    destination = open("destination.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (destination == -1)
    {
        perror("Error creating destination file");
        close(source);
        return 1;
    }

    /* Copy content from source to destination */
    while ((n = read(source, buffer, sizeof(buffer))) > 0)
    {
        write(destination, buffer, n);
    }

    if (n == -1)
    {
        perror("Error reading source file");
    }
    else
    {
        printf("File copied successfully!\n");
    }

    /* Close both files */
    close(source);
    close(destination);

    return 0;
}
